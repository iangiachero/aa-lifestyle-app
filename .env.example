# Copy to .env and fill in. Ask the project owner for real values — never
# commit .env itself, it's gitignored on purpose.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (web checkout — see HANDOFF.md, keys are currently LIVE mode)
VITE_STRIPE_MONTHLY_PRICE_ID=
VITE_STRIPE_MONTHLY_PRODUCT_ID=
VITE_STRIPE_YEARLY_PRICE_ID=
VITE_STRIPE_YEARLY_PRODUCT_ID=

# RevenueCat (native In-App Purchase — see HANDOFF.md section 4.2)
# Public SDK key, iOS app, from the RevenueCat dashboard. Safe to expose to
# the client — it's a public key by design, same as the Stripe/Supabase ones
# above.
VITE_REVENUECAT_IOS_API_KEY=

# Iconify icon search (optional — used by the icon picker, if re-enabled)
VITE_ICONIFY_API_BASE=
VITE_ICONIFY_PREFIXES=
VITE_ICONIFY_SEARCH_LIMIT=

# --- Supabase Edge Function secrets ---
# These are NOT read by the client bundle — set them with
# `supabase secrets set NAME=value`, not in this file.
#
# SUPABASE_SERVICE_ROLE_KEY   used by every edge function
# STRIPE_SECRET_KEY           stripe-checkout, stripe-portal, stripe-webhook
# STRIPE_WEBHOOK_SECRET       stripe-webhook
# REVENUECAT_SECRET_API_KEY   revenuecat-webhook — RevenueCat dashboard, secret key
# REVENUECAT_WEBHOOK_SECRET   revenuecat-webhook — a string you invent, entered
#                              in RevenueCat's webhook config as the auth header
